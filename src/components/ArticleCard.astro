---
import type { Article } from '../lib/types';
import { categoryLabels, isCategoryLabel, ui, type UiLanguage } from '../lib/i18n';
import { stripMarkdown } from '../lib/markdown';

interface Props {
  article: Article;
  lang: UiLanguage;
}

const { article, lang } = Astro.props;
const t = ui[lang];
const href = `/${lang}/${article.category}/${article.slug}`;
const categoryLabel = categoryLabels[lang][article.category];
const tags = article.tags.filter((tag) => !isCategoryLabel(tag, article.category)).slice(0, 3);
const formatDate = (value: string | null) => {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return lang === 'zh'
    ? date.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric' })
    : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
};
---
<article class="card">
  <div class="top">
    <span class="tag-cat">{categoryLabel}</span>
    <span class="tag-score">Quality {article.sourceQualityScore}</span>
    <span class={article.heatScore > 80 ? 'tag-score hot' : 'tag-score'}>Heat {article.heatScore}</span>
    <time>{formatDate(article.publishedAt)}</time>
  </div>
  <h3><a href={href}>{article.title}</a></h3>
  <p>{stripMarkdown(article.summary)}</p>
  <div class="lead-meta">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <a class="go" href={href}>{t.readMore} →</a>
</article>
