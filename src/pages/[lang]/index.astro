---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getDb, listArticles, listPersonalResources, getAllSources, getBriefingByDate } from '../../lib/db';
import { briefingDate } from '../../lib/briefing';
import { pickLeadArticle } from '../../lib/lead';
import { stripMarkdown } from '../../lib/markdown';
import { ui, categoryLabels, isCategoryLabel, type UiLanguage } from '../../lib/i18n';
import type { Article } from '../../lib/types';

const lang = Astro.params.lang as UiLanguage;
if (lang !== 'zh' && lang !== 'en') {
  return Astro.rewrite('/404');
}

const t = ui[lang];
const db = await getDb(Astro.locals);
const allArticles = await listArticles(db, lang, { limit: 40 }); // headroom above the 24 displayed slots so dedupe never starves a section
const todayBriefing = await getBriefingByDate(db, lang, briefingDate());
const lead = pickLeadArticle(allArticles, new Date(), todayBriefing?.items?.[0]?.articleSlug ?? null);
// Every slot on the page shows content not seen elsewhere: the hero lead is
// excluded from every list, and the News section shows the news items AFTER
// the 7-row latest feed window (items 8-10).
const leadId = lead?.id;
const notLead = (article: Article) => article.id !== leadId;
const tools = allArticles.filter((article) => article.category === 'tools' && notLead(article)).slice(0, 3);
const resources = allArticles.filter((article) => article.category === 'resources' && notLead(article)).slice(0, 3);
const research = allArticles.filter((article) => article.category === 'research' && notLead(article)).slice(0, 3);
const prompts = allArticles.filter((article) => article.category === 'prompts' && notLead(article)).slice(0, 3);
const newsPool = await listArticles(db, lang, { category: 'news', limit: 10 });
const feedNews = newsPool.filter(notLead).slice(0, 7);
const news = newsPool.filter(notLead).slice(7, 10);
const personal = await listPersonalResources(db, lang);
// Novels live apart from the main personal cards, as plain links — they are
// personal recommendations, not site content, and used to sit at full card
// weight next to the Fold app.
const personalMain = personal.filter((resource) => resource.resourceType !== 'novel');
const personalNovels = personal.filter((resource) => resource.resourceType === 'novel');
const leadCategoryLabel = lead ? categoryLabels[lang][lead.category as keyof typeof categoryLabels['zh']] : '';
const leadTags = (lead?.tags ?? []).filter((tag) => !isCategoryLabel(tag, lead?.category ?? '')).slice(0, 3);
// All sources per displayed article, one query (most reliable first).
const shown = [lead, ...feedNews, ...news, ...tools, ...resources, ...research, ...prompts].filter((a): a is Article => Boolean(a));
const allSources = await getAllSources(db, [...new Set(shown.map((a) => a.contentGroupId))]);
const leadSources = lead ? allSources.get(lead.contentGroupId) : undefined;
const now = new Date();
const feedbackSent = Astro.url.searchParams.get('feedback') === 'sent';
const todayText = lang === 'zh'
  ? `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, '0')}.${String(now.getDate()).padStart(2, '0')}`
  : now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const formatDate = (value: string | null) => {
  if (!value) return '';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return lang === 'zh'
    ? date.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai', month: 'numeric', day: 'numeric' })
    : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
};
const sectionEn: Record<string, string> = {
  tools: 'Tools',
  news: 'News',
  resources: 'Resources',
  research: 'Research',
  prompts: 'Prompts',
  personal: 'Personal',
};
const sectionZh: Record<string, string> = {
  tools: '工具',
  news: '新闻',
  resources: '资源',
  research: '研究',
  prompts: '提示词',
  personal: '个人',
};
---
<BaseLayout
  title={lang === 'zh' ? 'ACP AI 研究站 · 每日 AI 新闻、工具与研究' : 'ACP AI Research Station — Daily AI News, Tools & Research'}
  description={lang === 'zh' ? '每日 AI 新闻、工具、研究与资源，中英双语，来源可查。' : 'Daily AI news, tools, research and resources in English and Chinese, with verifiable sources.'}
  lang={lang}>
  <main>
    <section class="hero" id="today">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="shell">
        <span class="chip"><span class="dot"></span><b>{todayText}</b> · {t.reviewed} · {t.bilingual}</span>
        <h1>{lead?.title}</h1>
        <p class="hero-sub">{lead ? stripMarkdown(lead.summary) : ''}</p>
        <div class="lead-meta hero-tags">
          <span class="tag-cat">{leadCategoryLabel || t.news}</span>
          <span class="tag-score">Quality {lead?.sourceQualityScore ?? 0}</span>
          <span class={lead && lead.heatScore > 80 ? 'tag-score hot' : 'tag-score'}>Heat {lead?.heatScore ?? 0}</span>
          {leadTags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        {leadSources && leadSources.length > 0 && (
          <p class="hero-src">{t.source}：{leadSources.map((s, i) => (<><a href={s.url} target="_blank" rel="noopener noreferrer">{s.publisher ?? s.title}</a>{i < leadSources.length - 1 ? '、' : ''}</>))}</p>
        )}
        <details class="score-note">
          <summary>{t.scoreHow}</summary>
          <p>{t.scoreNote}</p>
        </details>
        <div class="hero-actions">
          {lead && <a class="pill-btn primary btn-lg" href={`/${lang}/${lead.category}/${lead.slug}`}>{t.readMore}</a>}
          <a class="pill-btn btn-lg" href="#latest">{lang === 'zh' ? '浏览最新文章' : 'Browse latest articles'} ↓</a>
        </div>
        <div class="hero-meta">
          {lang === 'zh' ? (
            <>
              <span>最新 {shown.length} 篇</span><span>6 个栏目</span><span>EN / 中文双语</span><span>每日更新</span>
            </>
          ) : (
            <>
              <span>Latest {shown.length} articles</span><span>6 sections</span><span>EN / 中文</span><span>Updated daily</span>
            </>
          )}
        </div>
      </div>
    </section>

    {todayBriefing && (
    <section class="shell sections brief-strip">
      <section class="blk">
        <div class="blk-head">
          <div>
            <h2>{t.briefingTop5}{lang === 'zh' ? <span class="zh"> · {t.briefing}</span> : ''}</h2>
            <p>{todayBriefing.overview}</p>
          </div>
          <a class="more" href={`/${lang}/briefing/${todayBriefing.date}`}>{t.readBriefing} →</a>
        </div>
        <div class="feed">
          {todayBriefing.items.filter((item) => item.articleSlug !== lead?.slug).slice(0, 5).map((item, i) => (
            <a class="feed-row" href={`/${lang}/briefing/${todayBriefing.date}`}>
              <span class="brief-rank">{i + 1}</span>
              <span class="t">
                <span class="ttl">{item.title}</span>
                <span class="dsc">{stripMarkdown(item.summary)}</span>
              </span>
              <span class={item.score > 80 ? 'tag-score hot' : 'tag-score'}>{lang === 'zh' ? `简报分 ${item.score}` : `Briefing ${item.score}`}</span>
              <span class="arr">→</span>
            </a>
          ))}
        </div>
      </section>
    </section>
    )}

    <section class="shell window-zone" id="latest">
      <div class="window-glow" aria-hidden="true"></div>
      <div class="window">
        <div class="win-bar">
          <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="win-url">acp.dpdns.org</span>
          <span class="live"><i></i>LIVE</span>
        </div>
        <div class="win-body">
          <div class="win-main">
            <div class="win-toolbar">
              <h2>{lang === 'zh' ? '最新文章' : 'Latest articles'}</h2>
              <span class="upd">UPDATED {todayText}</span>
            </div>
            <div class="feed">
              {feedNews.map((item) => {
                const ss = allSources.get(item.contentGroupId) ?? [];
                return (
                <a class="feed-row" href={`/${lang}/${item.category}/${item.slug}`}>
                  <span class="cat">NEWS</span>
                  <span class="t">
                    <span class="ttl">{item.title}</span>
                    <span class="dsc">{stripMarkdown(item.summary)}</span>
                    {ss.length > 0 && <span class="src">{t.source}：{ss.map((s, i) => (<><a href={s.url} target="_blank" rel="noopener noreferrer">{s.publisher ?? s.title}</a>{i < ss.length - 1 ? '、' : ''}</>))}</span>}
                  </span>
                  <time>{formatDate(item.publishedAt)}</time>
                  <span class={item.heatScore > 80 ? 'tag-score hot' : 'tag-score'}>Heat {item.heatScore}</span>
                  <span class="arr">→</span>
                </a>
                );
              })}
            </div>
          </div>
        </div>
        <div class="win-foot">
          <span>{lang === 'zh' ? '数据来自本站 · 每日更新' : 'Live data · updated daily'}</span>
          <a href={`/${lang}/news`}>{t.newsArchive} →</a>
          <span class="r">{feedNews.length} ITEMS</span>
        </div>
      </div>
    </section>

    <div class="shell">
      <div class="toolbar" id="search">
        <div class="searchbox">
          <span class="search-icon">⌕</span>
          <input type="text" class="search-input" placeholder={t.search} id="searchInput" />
        </div>
      </div>
      <div class="search-results" id="searchResults" hidden></div>
    </div>

    <section class="shell sections">
      <section class="blk" id="tools">
        <div class="blk-head">
          <span class="idx">01</span>
          <div>
            <h2>{sectionEn.tools}{lang === 'zh' ? <span class="zh"> · {sectionZh.tools}</span> : ''}</h2>
            <p>{lang === 'zh' ? '从适用人群、价格、可靠性和替代品角度评估近期活跃项目' : 'Evaluate active AI projects by fit, pricing, reliability, and alternatives.'}</p>
          </div>
          <a class="more" href={`/${lang}/tools`}>{t.moreReviews} →</a>
        </div>
        <div class="cards">{tools.map((article) => <ArticleCard article={article} lang={lang} sources={allSources.get(article.contentGroupId)} />)}</div>
      </section>

      <section class="blk" id="news">
        <div class="blk-head">
          <span class="idx">02</span>
          <div>
            <h2>{sectionEn.news}{lang === 'zh' ? <span class="zh"> · {sectionZh.news}</span> : ''}</h2>
            <p>{lang === 'zh' ? '每日高热消息摘要，并补充影响分析' : 'Daily high-signal AI news with impact analysis.'}</p>
          </div>
          <a class="more" href={`/${lang}/news`}>{t.newsArchive} →</a>
        </div>
        <div class="feed">
          {news.map((item) => {
            const ss = allSources.get(item.contentGroupId) ?? [];
            return (
            <a class="feed-row" href={`/${lang}/${item.category}/${item.slug}`}>
              <span class="cat">NEWS</span>
              <span class="t">
                <span class="ttl">{item.title}</span>
                <span class="dsc">{stripMarkdown(item.summary)}</span>
                {ss.length > 0 && <span class="src">{t.source}：{ss.map((s, i) => (<><a href={s.url} target="_blank" rel="noopener noreferrer">{s.publisher ?? s.title}</a>{i < ss.length - 1 ? '、' : ''}</>))}</span>}
              </span>
              <time>{formatDate(item.publishedAt)}</time>
              <span class={item.heatScore > 80 ? 'tag-score hot' : 'tag-score'}>Heat {item.heatScore}</span>
              <span class="arr">→</span>
            </a>
            );
          })}
        </div>
      </section>

      <section class="blk" id="resources">
        <div class="blk-head">
          <span class="idx">03</span>
          <div>
            <h2>{sectionEn.resources}{lang === 'zh' ? <span class="zh"> · {sectionZh.resources}</span> : ''}</h2>
            <p>{lang === 'zh' ? '免费额度、开源资源、课程和可领取权益，标注时效与限制' : 'Credits, open-source assets, courses, and limited resources with constraints.'}</p>
          </div>
          <a class="more" href={`/${lang}/resources`}>{t.resourceLibrary} →</a>
        </div>
        <div class="cards">{resources.map((article) => <ArticleCard article={article} lang={lang} sources={allSources.get(article.contentGroupId)} />)}</div>
      </section>

      <section class="blk" id="research">
        <div class="blk-head">
          <span class="idx">04</span>
          <div>
            <h2>{sectionEn.research}{lang === 'zh' ? <span class="zh"> · {sectionZh.research}</span> : ''}</h2>
            <p>{lang === 'zh' ? '把近期热门概念讲清楚，给出背景、玩家、争议和判断' : 'Explain hot AI concepts with context, players, controversy, and judgment.'}</p>
          </div>
          <a class="more" href={`/${lang}/research`}>{t.researchTopics} →</a>
        </div>
        <div class="cards">{research.map((article) => <ArticleCard article={article} lang={lang} sources={allSources.get(article.contentGroupId)} />)}</div>
      </section>

      {prompts.length > 0 && (
      <section class="blk" id="prompts">
        <div class="blk-head">
          <span class="idx">05</span>
          <div>
            <h2>{sectionEn.prompts}{lang === 'zh' ? <span class="zh"> · {sectionZh.prompts}</span> : ''}</h2>
            <p>{lang === 'zh' ? '精选近三个月内出现或更新、可直接复用的高质量提示词与完整 AI 工作流。' : 'Reusable, high-quality prompts and complete AI workflows published or updated within the past three months.'}</p>
          </div>
          <a class="more" href={`/${lang}/prompts`}>{t.promptLibrary} →</a>
        </div>
        <div class="cards">{prompts.map((article) => <ArticleCard article={article} lang={lang} sources={allSources.get(article.contentGroupId)} />)}</div>
      </section>
      )}

      <section class="blk" id="personal">
        <div class="blk-head">
          <span class="idx">{prompts.length > 0 ? '06' : '05'}</span>
          <div>
            <h2>{sectionEn.personal}{lang === 'zh' ? <span class="zh"> · {sectionZh.personal}</span> : ''}</h2>
            <p>{lang === 'zh' ? '站长项目、APP、教程、提示词和个人整理资源' : 'Owner-managed apps, tutorials, prompts, and curated resources.'}</p>
          </div>
          <a class="more" href={`/${lang}/personal`}>{t.manageResources} →</a>
        </div>
        <div class="cards">
          {personalMain.map((resource) => (
            <article class="card">
              <div class="top"><span class="tag-cat">{t.personal}</span></div>
              <h3><a href={resource.url} target={resource.url.startsWith('/') ? undefined : '_blank'} rel={resource.url.startsWith('/') ? undefined : 'noopener noreferrer'}>{resource.title}</a></h3>
              <p>{resource.description}</p>
              <a class="go" href={resource.url} target={resource.url.startsWith('/') ? undefined : '_blank'} rel={resource.url.startsWith('/') ? undefined : 'noopener noreferrer'}>{resource.url === '/app' ? t.openApp : t.readMore} →</a>
            </article>
          ))}
        </div>
        {personalNovels.length > 0 && (
          <div class="personal-novels">
            <span class="personal-novels-label">{lang === 'zh' ? '小说推荐' : 'Novel recommendations'}</span>
            {personalNovels.map((resource) => (
              <a href={resource.url} target="_blank" rel="noopener noreferrer">{resource.title}</a>
            ))}
          </div>
        )}
      </section>

      <section class="blk feedback-blk" id="feedback">
        <div class="blk-head">
          <div>
            <h2>{t.feedbackTitle}</h2>
            <p>{t.feedbackDesc}</p>
          </div>
        </div>
        {feedbackSent && <p class="feedback-success">{t.feedbackSent}</p>}
        <form class="feedback-form" method="post" action="/api/feedback">
          <input type="hidden" name="language" value={lang} />
          <input type="hidden" name="sourcePath" value={Astro.url.pathname} />
          <div class="feedback-grid">
            <input class="input" name="name" placeholder={t.feedbackName} maxlength="80" />
            <input class="input" name="email" type="email" placeholder={t.feedbackEmail} maxlength="160" />
          </div>
          <textarea class="input textarea" name="message" placeholder={t.feedbackMessage} rows="3" maxlength="2000" required></textarea>
          <button class="form-btn primary" type="submit">{t.feedbackSubmit}</button>
        </form>
      </section>
    </section>
  </main>
  <script define:vars={{ lang, noResults: t.searchNoResults, archiveLabel: t.newsArchive, archiveHref: `/${lang}/news` }}>
    const input = document.getElementById('searchInput');
    const panel = document.getElementById('searchResults');
    const pageSections = document.querySelectorAll('.window-zone, .sections');
    let indexPromise = null;

    function esc(s) {
      return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function loadIndex() {
      if (!indexPromise) {
        indexPromise = fetch('/search-index-' + lang + '.json')
          .then(function (r) { if (!r.ok) throw new Error('index ' + r.status); return r.json(); })
          .then(function (data) { return Array.isArray(data) ? data : (data.items || []); })
          .catch(function () { indexPromise = null; return []; });
      }
      return indexPromise;
    }
    function setSearching(active) {
      pageSections.forEach(function (el) { el.style.display = active ? 'none' : ''; });
      if (panel) panel.hidden = !active;
    }
    function renderResults(items, query) {
      if (!panel) return;
      if (items.length === 0) {
        panel.innerHTML = '<p class="search-empty">' + esc(noResults) + '「' + esc(query) + '」。<a href="' + esc(archiveHref) + '">' + esc(archiveLabel) + ' →</a></p>';
        return;
      }
      panel.innerHTML = '<div class="feed">' + items.map(function (item) {
        return '<a class="feed-row" href="' + esc(item.u) + '">'
          + '<span class="cat">' + esc(String(item.c || '').toUpperCase()) + '</span>'
          + '<span class="t"><span class="ttl">' + esc(item.t) + '</span>'
          + (item.s ? '<span class="dsc">' + esc(item.s) + '</span>' : '')
          + '</span>'
          + (item.d ? '<time>' + esc(item.d) + '</time>' : '')
          + '<span class="arr">→</span></a>';
      }).join('') + '</div>';
    }
    function runSearch() {
      if (!input || !panel) return;
      const query = input.value.trim().toLowerCase();
      if (!query) { setSearching(false); panel.innerHTML = ''; return; }
      setSearching(true);
      const tokens = query.split(/\s+/).filter(Boolean);
      loadIndex().then(function (items) {
        if (input.value.trim().toLowerCase() !== query) return;
        const hits = items.filter(function (item) {
          const hay = ((item.t || '') + ' ' + (item.s || '') + ' ' + (item.c || '')).toLowerCase();
          return tokens.every(function (tok) { return hay.indexOf(tok) !== -1; });
        }).slice(0, 12);
        renderResults(hits, input.value.trim());
      });
    }
    if (input) {
      let timer = null;
      input.addEventListener('input', function () {
        if (timer) clearTimeout(timer);
        timer = setTimeout(runSearch, 150);
      });
      // Coming from the 404 page (or any link) with ?q= : run the search on load.
      const preset = new URLSearchParams(window.location.search).get('q');
      if (preset) {
        input.value = preset;
        runSearch();
        document.getElementById('search').scrollIntoView();
      }
    }
  </script>
  <style>
    .brief-strip .brief-rank { flex: none; width: 26px; height: 26px; border-radius: 7px; background: var(--accent); color: #fff; font-family: var(--mono); font-size: 13px; font-weight: 600; line-height: 26px; text-align: center; align-self: center; }
    .search-results { margin-top: 14px; }
    .search-results[hidden] { display: none; }
    .search-results .feed-row .t .dsc { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .search-empty { padding: 18px 10px; font-size: 14px; color: var(--body); }
    .search-empty a { color: var(--text); text-decoration: underline; text-underline-offset: 2px; }
  </style>
</BaseLayout>
