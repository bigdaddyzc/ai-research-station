---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb, getBriefingByDate } from '../../../lib/db';
import { ui, type UiLanguage } from '../../../lib/i18n';

const lang = Astro.params.lang as UiLanguage;
const date = Astro.params.date ?? '';
if ((lang !== 'zh' && lang !== 'en') || !/^\d{4}-\d{2}-\d{2}$/.test(date)) {
  return new Response('Not Found', { status: 404 });
}

const t = ui[lang];
const db = await getDb(Astro.locals);
const briefing = await getBriefingByDate(db, lang, date);
if (!briefing) {
  return new Response('Not Found', { status: 404 });
}
const formatDate = (value: string) => {
  const d = new Date(value + 'T00:00:00+08:00');
  if (Number.isNaN(d.getTime())) return value;
  return lang === 'zh'
    ? d.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' })
    : d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
};
---
<BaseLayout
  title={`${briefing.title} · ACP AI Research`}
  description={briefing.overview}
  lang={lang}>
  <main>
    <section class="shell page-head">
      <span class="eyebrow">ACP / {t.briefing.toUpperCase()} / {formatDate(briefing.date)}</span>
      <h1>{briefing.title}</h1>
      <p>{briefing.overview}</p>
    </section>
    <section class="shell sections">
      <ol class="brief-list">
        {briefing.items.map((item) => (
          <li class="brief-item">
            <div class="brief-head">
              <span class="brief-rank">{item.rank}</span>
              <h2>
                {item.articleSlug && item.articleCategory ? (
                  <a href={`/${lang}/${item.articleCategory}/${item.articleSlug}`}>{item.title}</a>
                ) : (
                  item.title
                )}
              </h2>
              <span class={item.score > 80 ? 'tag-score hot' : 'tag-score'}>{item.score}</span>
            </div>
            <p class="brief-summary">{item.summary}</p>
            <p class="brief-why"><b>{t.whyItMatters}{lang === 'zh' ? '：' : ': '}</b>{item.whyItMatters}</p>
            <p class="brief-src">{t.source}{lang === 'zh' ? '：' : ': '}
              {item.sources.map((s, i) => (
                <span>
                  <a href={s.url} target="_blank" rel="noopener noreferrer">{s.publisher || s.title}</a>
                  {i < item.sources.length - 1 ? ' · ' : ''}
                </span>
              ))}
            </p>
            {item.articleSlug && item.articleCategory && (
              <p class="brief-more"><a class="go" href={`/${lang}/${item.articleCategory}/${item.articleSlug}`}>{t.readMore} →</a></p>
            )}
          </li>
        ))}
      </ol>
      <p class="brief-back"><a href={`/${lang}/briefing`}>← {t.briefingArchive}</a></p>
    </section>
  </main>
</BaseLayout>
<style>
  .brief-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .brief-item { border-top: 1px solid var(--line); padding-top: 20px; }
  .brief-head { display: flex; align-items: baseline; gap: 12px; }
  .brief-rank { flex: none; width: 30px; height: 30px; border-radius: 8px; background: var(--accent); color: #fff; font-family: var(--mono); font-size: 14px; font-weight: 600; line-height: 30px; text-align: center; }
  .brief-head h2 { margin: 0; flex: 1; min-width: 0; font-size: 20px; line-height: 1.4; letter-spacing: -0.01em; }
  .brief-head h2 a { color: inherit; text-decoration: none; }
  .brief-head h2 a:hover { color: var(--accent); }
  .brief-head .tag-score { flex: none; align-self: center; }
  .brief-summary { margin: 10px 0 6px; color: var(--body); line-height: 1.75; }
  .brief-why { margin: 0 0 6px; color: var(--body); line-height: 1.75; }
  .brief-src { margin: 0; color: var(--muted); font-size: 13.5px; line-height: 1.7; }
  .brief-src a { color: var(--accent); }
  .brief-more { margin: 8px 0 0; }
  .brief-more .go { color: var(--accent); font-size: 14px; font-weight: 600; text-decoration: none; }
  .brief-back { margin-top: 32px; }
  .brief-back a { color: var(--muted); text-decoration: none; }
  .brief-back a:hover { color: var(--accent); }
</style>
