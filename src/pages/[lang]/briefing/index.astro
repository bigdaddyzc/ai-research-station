---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb, listBriefings } from '../../../lib/db';
import { ui, type UiLanguage } from '../../../lib/i18n';

const lang = Astro.params.lang as UiLanguage;
if (lang !== 'zh' && lang !== 'en') {
  return new Response('Not Found', { status: 404 });
}

const t = ui[lang];
const db = await getDb(Astro.locals);
const briefings = await listBriefings(db, lang, 30);
const formatDate = (value: string) => {
  const date = new Date(value + 'T00:00:00+08:00');
  if (Number.isNaN(date.getTime())) return value;
  return lang === 'zh'
    ? date.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric' })
    : date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
};
---
<BaseLayout
  title={`${t.briefing} · ACP AI Research`}
  description={t.briefingDesc}
  lang={lang}>
  <main>
    <section class="shell page-head">
      <span class="eyebrow">ACP / BRIEFING</span>
      <h1>{t.briefing}</h1>
      <p>{t.briefingDesc}</p>
    </section>
    <section class="shell sections">
      {briefings.length === 0 ? (
        <p style="color: var(--muted); text-align: center; padding: 40px 0;">{t.briefingEmpty}</p>
      ) : (
        <div class="feed">
          {briefings.map((b) => (
            <a class="feed-row" href={`/${lang}/briefing/${b.date}`}>
              <span class="cat">BRIEFING</span>
              <span class="t">
                <span class="ttl">{b.title}</span>
                <span class="dsc">{b.overview}</span>
              </span>
              <time>{formatDate(b.date)}</time>
              <span class="arr">→</span>
            </a>
          ))}
        </div>
      )}
    </section>
  </main>
</BaseLayout>
