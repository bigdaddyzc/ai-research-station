---
import '../styles/global.css';
import { ui, type UiLanguage } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: UiLanguage;
  ogType?: string;
}

const { title = 'ACP AI Research Station — Daily AI News, Tools & Research', description = 'Daily AI news, tools, research and resources in English and Chinese, with verifiable sources.', lang = 'zh', ogType = 'website' } = Astro.props;
const t = ui[lang];
const otherLang = lang === 'zh' ? 'en' : 'zh';
const currentPath = Astro.url.pathname;
const otherPath = currentPath.startsWith('/zh') ? currentPath.replace('/zh', '/en') : currentPath.startsWith('/en') ? currentPath.replace('/en', '/zh') : `/${otherLang}`;
const siteUrl = 'https://acp.dpdns.org';
const canonical = siteUrl + currentPath;
const isContentPage = currentPath.startsWith('/zh') || currentPath.startsWith('/en');
const zhUrl = lang === 'zh' ? canonical : siteUrl + otherPath;
const enUrl = lang === 'en' ? canonical : siteUrl + otherPath;
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const ogLocaleAlternate = lang === 'zh' ? 'en_US' : 'zh_CN';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {isContentPage && (
      <>
        <link rel="alternate" hreflang="zh" href={zhUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={zhUrl} />
      </>
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ACP AI Research Station" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={siteUrl + '/og.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + '/og.png'} />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <div class="shell nav">
        <a class="brand" href={`/${lang}`}>
          <span class="brand-mark">A</span>
          <span>ACP</span>
          <small>AI Research</small>
        </a>
        <nav class="links" id="primaryNav" aria-label="Primary navigation">
          <a href={`/${lang}#today`}>{t.today}</a>
          <a href={`/${lang}/tools`}>{t.tools}</a>
          <a href={`/${lang}/news`}>{t.news}</a>
          <a href={`/${lang}/resources`}>{t.resources}</a>
          <a href={`/${lang}/research`}>{t.research}</a>
          <a href={`/${lang}/prompts`}>{t.prompts}</a>
          <a href={`/${lang}/personal`}>{t.personal}</a>
          <a href={`/${lang}#feedback`}>{t.feedback}</a>
        </nav>
        <div class="actions">
          <a class="pill-btn" href="/rss.xml">RSS</a>
          <a class="icon-btn" title="Search" aria-label="Search" href={`/${lang}#search`} onclick="const el=document.getElementById('searchInput');if(el){event.preventDefault();el.scrollIntoView({behavior:'smooth',block:'center'});setTimeout(()=>el.focus(),300);}">⌕</a>
          <a class="pill-btn" title="Switch language" href={otherPath}>{otherLang.toUpperCase()}</a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primaryNav" aria-label="Menu">☰</button>
        </div>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="shell">
        <div class="foot-grid">
          <div class="foot-brand">
            <a class="brand" href={`/${lang}`}>
              <span class="brand-mark">A</span>
              <span>ACP</span>
              <small>AI Research</small>
            </a>
            <p>{t.footer}</p>
          </div>
          <div class="foot-col">
            <h4>{lang === 'zh' ? '栏目' : 'Sections'}</h4>
            <a href={`/${lang}/tools`}>{t.tools}</a>
            <a href={`/${lang}/news`}>{t.news}</a>
            <a href={`/${lang}/resources`}>{t.resources}</a>
            <a href={`/${lang}/research`}>{t.research}</a>
            <a href={`/${lang}/prompts`}>{t.prompts}</a>
            <a href={`/${lang}/personal`}>{t.personal}</a>
          </div>
          <div class="foot-col">
            <h4>{lang === 'zh' ? '本站' : 'Site'}</h4>
            <a href="/rss.xml">RSS</a>
            <a href="/sitemap.xml">Sitemap</a>
            <a href="/privacy">Privacy</a>
          </div>
          <div class="foot-col">
            <h4>{lang === 'zh' ? '关于本站' : 'About'}</h4>
            <p class="foot-about">{lang === 'zh' ? '每日 AI 新闻、工具与研究，中英双语，来源可查。' : 'Daily AI news, tools and research in English and Chinese, with verifiable sources.'}</p>
            <a href={`/${lang}#feedback`}>{lang === 'zh' ? '提交建议 →' : 'Send feedback →'}</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>ACP AI RESEARCH — DAILY AI NEWS, TOOLS &amp; RESEARCH</span>
          <span class="r">RSS · SITEMAP · PRIVACY</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var toggle = document.querySelector('.nav-toggle');
        var header = document.querySelector('.topbar');
        if (!toggle || !header) return;
        toggle.addEventListener('click', function () {
          var open = header.classList.toggle('nav-open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        header.querySelectorAll('.links a').forEach(function (link) {
          link.addEventListener('click', function () {
            header.classList.remove('nav-open');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      })();
    </script>
  </body>
</html>
