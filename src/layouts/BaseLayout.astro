---
import '../styles/global.css';
import { ui, type UiLanguage } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: UiLanguage;
}

const defaultDescription = Astro.props.lang === 'en'
  ? 'Daily AI news, tools, research, free resources and prompt workflows, with cited sources.'
  : '每日精选 AI 新闻、工具、研究、免费资源与提示词工作流，每篇都附可靠来源。';
const { title = 'ACP AI Research', description = defaultDescription, lang = 'zh' } = Astro.props;
const siteUrl = 'https://acp.dpdns.org';
const t = ui[lang];
const otherLang = lang === 'zh' ? 'en' : 'zh';
const currentPath = Astro.url.pathname;
const otherPath = currentPath.startsWith('/zh') ? currentPath.replace('/zh', '/en') : currentPath.startsWith('/en') ? currentPath.replace('/en', '/zh') : `/${otherLang}`;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={`${siteUrl}${currentPath === '/' ? '/zh' : currentPath}`} />
    {(currentPath.startsWith('/zh') || currentPath.startsWith('/en') || currentPath === '/') && (
      <>
        <link rel="alternate" hreflang="zh-CN" href={`${siteUrl}${currentPath.startsWith('/en') ? currentPath.replace('/en', '/zh') : currentPath === '/' ? '/zh' : currentPath}`} />
        <link rel="alternate" hreflang="en" href={`${siteUrl}${currentPath.startsWith('/zh') ? currentPath.replace('/zh', '/en') : currentPath === '/' ? '/en' : currentPath}`} />
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}/zh`} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="ACP AI Research" href={`${siteUrl}/rss.xml`} />
    <meta property="og:site_name" content="ACP AI Research" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${siteUrl}${currentPath}`} />
    <meta property="og:type" content={currentPath.split('/').length > 3 ? 'article' : 'website'} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={`${siteUrl}/og-default.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/og-default.png`} />
    <link rel="alternate" type="text/plain" title="llms.txt" href={`${siteUrl}/llms.txt`} />
  </head>
  <body>
    <header class="topbar">
      <div class="shell nav">
        <a class="brand" href={`/${lang}`}>
          <span class="brand-mark">ACP</span>
          <span>ACP AI Research</span>
        </a>
        <nav class="links" aria-label="Primary navigation">
          <a href={`/${lang}#today`}>{t.today}</a>
          <a href={`/${lang}/tools`}>{t.tools}</a>
          <a href={`/${lang}/news`}>{t.news}</a>
          <a href={`/${lang}/resources`}>{t.resources}</a>
          <a href={`/${lang}/research`}>{t.research}</a>
          <a href={`/${lang}/prompts`}>{t.prompts}</a>
          <a href={`/${lang}/personal`}>{t.personal}</a>
          <a href={`/${lang}#feedback`}>{t.feedback}</a>
        </nav>
        <div class="actions">
          <a class="icon-btn" title="Search" aria-label="Search" href={`/${lang}#search`} onclick="const el=document.getElementById('searchInput');if(el){event.preventDefault();el.scrollIntoView({behavior:'smooth',block:'center'});setTimeout(()=>el.focus(),300);}">⌕</a>
          <a class="pill-btn" title="Switch language" href={otherPath}>{otherLang.toUpperCase()}</a>
        </div>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="shell footer-inner">
        <span>{t.footer}</span>
        <span class="footer-links"><a href={`/${lang}/about`}>{lang === 'zh' ? '关于' : 'About'}</a> · <a href="/rss.xml">RSS</a> · <a href="/sitemap.xml">Sitemap</a> · <a href="/llms.txt">llms.txt</a> · <a href="/privacy">{lang === 'zh' ? '隐私' : 'Privacy'}</a></span>
      </div>
    </footer>
  </body>
</html>
